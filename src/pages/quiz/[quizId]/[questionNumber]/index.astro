---
import Layout from "layouts/Layout.astro";
import type { Answers, APIResponse } from "types";
import { AnswerForm } from "components/AnswerForm.tsx";
import { getQuiz, getLocalQuiz } from "utils/getQuiz";
import { getCookieName } from "utils/getCookieName";
import { getRandomQuestion } from "utils/getRandomQuestion";
import { isNullOrUndefined } from "utils/isNullOrUndefined";

export const prerender = false;

const { quizId, questionNumber: questionNumberString } = Astro.params;

if (!quizId || !questionNumberString) {
  return Astro.redirect("/404");
}

const cookieKey = getCookieName(quizId);
const questionIndex = Number.parseInt(questionNumberString, 10);
const isPost = Astro.request.method === "POST";

const quizData = await getQuiz(quizId, Astro.session);
if (!quizData) {
  return Astro.redirect("/404");
}

if (quizData.mode === "close") {
  return Astro.redirect("closed");
}

const totalQuestions = quizData.questionsPerTest;
const currentQuestion = quizData.questions[questionIndex];

if (!questionNumberString || Number.isNaN(questionIndex) || !currentQuestion) {
  return Astro.redirect("/404");
}

let answers: Answers = {};
if (await Astro.session?.has(cookieKey)) {
  const answersCookie = await Astro.session?.get(cookieKey);
  answers = answersCookie ? (JSON.parse(answersCookie) as Answers) : {};
}

// A local bank contains 40 questions, but an attempt stops after 10.
if (
  getLocalQuiz(quizId) &&
  Object.keys(answers).length >= totalQuestions &&
  !Object.prototype.hasOwnProperty.call(answers, questionIndex)
) {
  return Astro.redirect(`/quiz/${quizId}/results`);
}

const meta = {
  title: `MMI Quiz - ${quizData.name}`,
  description: `Testez vos compétences avec ce questionnaire`,
};

// ---------- Gestion du temps par question (SERVER-SIDE) ----------

const timeByQuestionInSeconds =
  quizData.timeByQuestionInSeconds;
const answerGraceMs = 1000;

// Clé unique pour le deadline de CETTE question
const deadlineKey = `${quizData.uid ?? ""}:deadline:${questionIndex}`;

let deadline = 0;
let remainingSeconds = 0;

if (timeByQuestionInSeconds > 0) {
  const savedDeadline = await Astro.session?.get(deadlineKey);
  const now = Date.now();

  if (savedDeadline) {
    // On réutilise toujours le même deadline => refresh ne reset pas le temps
    deadline = Number(savedDeadline);
  } else {
    // Première fois qu'on arrive sur cette question
    deadline = now + timeByQuestionInSeconds * 1000;
    Astro.session?.set(deadlineKey, String(deadline));
  }

  // Temps restant en secondes, jamais négatif
  remainingSeconds = Math.max(0, (deadline - now) / 1000);

  // Si on arrive sur la page alors que le temps est déjà écoulé
  // et que l'étudiant n'a jamais répondu, on marque directement la question comme ratée
  if (remainingSeconds <= 0 && (!isPost || now > deadline + answerGraceMs) && isNullOrUndefined(answers[questionIndex])) {
    answers[questionIndex] = -1;
    Astro.session?.set(cookieKey, JSON.stringify(answers));
  }
}

// ---------- Quand une réponse est soumise (POST) ----------

if (isPost) {
  try {
    const data = await Astro.request.formData();
    const answerIndex = data.get("answerIndex");
    if (typeof answerIndex !== "string") {
      if (timeByQuestionInSeconds > 0 && Date.now() >= deadline) {
        answers[questionIndex] = -1;
        Astro.session?.set(cookieKey, JSON.stringify(answers));
      } else {
        throw new Error("No answer provided");
      }
    }

    // On ne modifie la réponse que si la question n'a jamais été "fixée"
    if (typeof answerIndex === "string" && isNullOrUndefined(answers[questionIndex])) {
      let stillInTime = true;

      if (timeByQuestionInSeconds > 0) {
        const savedDeadline = await Astro.session?.get(deadlineKey);
        const now = Date.now();

        if (!savedDeadline) {
          // Pas de deadline enregistré => on refuse par sécurité
          stillInTime = false;
        } else {
          const deadlineFromSession = Number(savedDeadline);
          // Allow one second for transport without extending the displayed timer.
          stillInTime = now <= deadlineFromSession + answerGraceMs;
        }
      }

      if (timeByQuestionInSeconds > 0 && !stillInTime) {
        // Trop tard => on force la question en -1
        answers[questionIndex] = -1;
        console.log("Réponse refusée (délai dépassé)");
      } else {
        // Réponse dans les temps
        answers[questionIndex] = Number.parseInt(answerIndex, 10);
      }

      Astro.session?.set(cookieKey, JSON.stringify(answers));
    }
  } catch (error) {
    if (error instanceof Error) {
      console.error(error.message);
    }
  }
}

// For malicious student that want the same question
// We already set the cookie in case they change the url for another question it will be count as a false response
if (answers[questionIndex] === null || answers[questionIndex] === undefined) {
  answers[questionIndex] = null;
  Astro.session?.set(cookieKey, JSON.stringify(answers));
}

const answeredIndexes = Object.keys(answers).map(Number);
const totalAnswers = answeredIndexes.length;
const nextQuestionIndex =
  totalAnswers < totalQuestions
    ? getRandomQuestion(quizData.questions, answeredIndexes)?.[1] ?? questionIndex
    : questionIndex;

---

<Layout title={meta.title}>
  {isNullOrUndefined(answers[questionIndex]) &&
  timeByQuestionInSeconds > 0 &&
  remainingSeconds > 0 && (
    <div
      id="quiz-timer"
      class="fixed inset-x-0 top-0 z-[1000]"
      data-duration={remainingSeconds}
      role="timer"
      aria-label="Temps restant pour cette question"
    >
      <div class="h-1.5 bg-base-300/80">
        <div data-timer-fill class="quiz-timer-fill h-full w-full bg-primary"></div>
      </div>
      <div class="quiz-timer-badge pointer-events-none absolute right-4 top-3 flex items-baseline gap-2 rounded-full border border-base-300 bg-base-100/95 px-3 py-1.5 text-base-content shadow-lg backdrop-blur-sm">
        <span class="text-xs font-medium">Temps restant</span>
        <strong class="quiz-timer-count font-mono text-base font-bold tabular-nums">
          <span data-timer-count>{Math.ceil(remainingSeconds)}</span> s
        </strong>
      </div>
    </div>
  )}
  <div class="flex flex-col gap-8">
    <div class="flex flex-col gap-4">
      <div class="text-sm font-semibold">
        <span class="text-white text-xl">
          Question {totalAnswers} sur {totalQuestions}
        </span>{" "}
        du quizz {quizData.name}
      </div>
      <progress
        class="progress progress-primary w-full max-w-lg"
        value={totalAnswers}
        max={totalQuestions}
      ></progress>
    </div>

    <p class="text-lg font-semibold break-words">{currentQuestion.question}</p>

    <AnswerForm
      hasMoreQuestions={totalAnswers < totalQuestions}
      answerIndex={answers[questionIndex]}
      quizId={quizId}
      answers={currentQuestion.answers}
      question={currentQuestion.question}
      correctAnswerIndex={currentQuestion.correctAnswerIndex}
      nextQuestionIndex={nextQuestionIndex}
      currentLocale={Astro.currentLocale}
      explanation={!isNullOrUndefined(answers[questionIndex]) ? currentQuestion.explanation : undefined}
      sourceLink={quizData.sourceCourse && currentQuestion.sourceSection ? `${quizData.sourceCourse}#${currentQuestion.sourceSection}` : undefined}
    />
  </div>
</Layout>

<script>
  let stopTimer: (() => void) | undefined;

  function startTimer() {
    stopTimer?.();

    const timer = document.querySelector<HTMLElement>("#quiz-timer");
    const fill = timer?.querySelector<HTMLElement>("[data-timer-fill]");
    const count = timer?.querySelector<HTMLElement>("[data-timer-count]");
    const form = document.querySelector<HTMLFormElement>("#answerForm");
    const duration = Number(timer?.dataset.duration ?? 0);
    if (!timer || !fill || !count || !form || duration <= 0) return;

    // The persistent sidebar sits above <main>; place the timer beside it.
    document.body.appendChild(timer);

    const expiresAt = performance.now() + duration * 1000;
    const updateCount = () => {
      const seconds = Math.max(0, Math.ceil((expiresAt - performance.now()) / 1000));
      count.textContent = String(seconds);
      timer.dataset.urgent = String(seconds <= 5);
    };

    fill.style.animation = "none";
    void fill.offsetWidth;
    fill.style.animation = `quiz-timer ${duration}s linear forwards`;
    updateCount();
    const interval = window.setInterval(updateCount, 100);
    const timeout = window.setTimeout(() => {
      updateCount();
      stopTimer?.();
      form.submit();
    }, duration * 1000);

    stopTimer = () => {
      window.clearInterval(interval);
      window.clearTimeout(timeout);
      fill.style.animationPlayState = "paused";
      form.removeEventListener("submit", onSubmit);
      stopTimer = undefined;
    };
    const onSubmit = () => stopTimer?.();
    form.addEventListener("submit", onSubmit);
  }

  document.addEventListener("astro:before-swap", () => stopTimer?.());
  document.addEventListener("astro:page-load", startTimer);
  startTimer();
</script>

<style is:global>
  @keyframes quiz-timer {
    from {
      transform: scaleX(1);
    }
    to {
      transform: scaleX(0);
    }
  }

  .quiz-timer-fill {
    transform-origin: left;
  }

  #quiz-timer[data-urgent="true"] .quiz-timer-fill {
    background-color: #ef4444;
  }

  #quiz-timer[data-urgent="true"] .quiz-timer-count {
    color: #ef4444;
  }
</style>
